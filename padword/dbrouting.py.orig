from django.conf import settings
from padword.commons import show_exc

class PadwordRouter(object):
    """ 
    A router to control all database operations on models in the
    oldversion application.
    """
    apps = {
                #'default':['auth'],
                #'cfg':['web'],
                #'default':['guest'],
                #'guest':['guest'],
                #'content':['contents'],
                #'users':['user_remote'],
            }

    def db_for_read(self, model, **hints):
        """ 
        Attempts to read oldversion models go to version1.
        """
        for database, apps in self.apps.items(): 
            if model._meta.app_label in apps:
                if database in settings.DATABASES.keys():
                    return database
                else:
                    return 'default'
        return None

    def db_for_write(self, model, **hints):
        """ 
        Attempts to write oldversion models go to version1.
        """
        for database, apps in self.apps.items(): 
            if model._meta.app_label in apps:
                if database in settings.DATABASES.keys():
                    return database
                else:
                    return 'default'
        return None

    def allow_relation(self, obj1, obj2, **hints):
        """ 
        Allow relations if a model in the oldversion app is involved.
        """
        db_00 = ""
        db_01 = ""
        for database, apps in self.apps.items(): 
            if obj1._meta.app_label in self.apps.items():
                db_00 = database
            if obj2._meta.app_label in self.apps.items():
                db_01 = database
        return db_00 == db_01

    def allow_migrate(self, db, app_label, model_name=None, **hints):
        """ 
        Make sure the oldversion app only appears in the 'version1' database.
        """
        return None

