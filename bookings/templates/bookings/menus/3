{% load i18n bookings_tag common_tag padword_tags static%}


<link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<link rel="stylesheet" href="{% static 'css/menu3.css' %}" >

{%comment%}
<div class="row d-flex justify-content-center mt-1 ">
    {% for item in category.get_items %}
        <div class="col-lg-2 col-md-3 col-xs-12 justify-content-center">
            <div class="card w-100 mb-3">
	            <div class="image" id="cover"> <img src="{% if item.image %}{{item.image.url}} {%else%} {% static 'img/none.png' %}{%endif%}" 
                    class="object-fit_cover" alt="{% padword_translate item.name %}"> </div>
                <div class="card-body">
                    <h5 class="card-title text-dark text-center">{% padword_translate item.name %}</h5>
                    <h4 class="card-title text-dark text-center">{{ item.price}} &euro; </h4>
                    <p class="card-text text-secondary">{% padword_translate item.description %}</p>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{%csrf_token%}
{%endcomment%}

<div class="container">
	<div class="row">
		<div class="col-3 offset-1">
			<div class="logo"><!--<img src="/static/img/logo-lanis.png">-->Logo</div>
		</div>
		<div class="col-6"></div>
		<div class="col-2">
			<div class="sugest-btn"><button type="button" class="btn btn-secondary w-100"><i class="far fa-star"></i> Sugerencias</button>
			</div>
		</div>
	</div>
	<div class="row align-items-end">
		<div id="div-current-category">
		   {% for children in category.get_childrens %}
		      <div class="mb-4" style="border:1px solid black !important; width: 20%;display:inline-block;">
		         <div class="col-2 align-middle justify-content-center">
		            <button class="btn btn-info ark" data-url="{% url "show-category-menu" %}" data-target="div-current-category" 
			    data-cat_id="{{children.uuid}}">{% padword_translate children.name %}</button>
		         </div>
		      </div>
		   {% endfor %}
		</div>
	</div>
	<div class="row bg-dark" style="position:fixed; bottom:0; width: 100%;left:1.1%;height: 60px;border:1px solid red;">
		<div class="col-3 offset-1">
			<div class="">Chat con recepción</div>
		</div>
		<div class="col-3">
			<div class="">Informacion COVID-19</div>
		</div>
		<div class="col-3">
			<div class="">Languages</div>
		</div>

	</div>


</div>


